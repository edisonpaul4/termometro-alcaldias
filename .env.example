# Copiar a .env (NUNCA subir .env al repositorio)

# mock = respuestas fijas de pipeline/fixtures (sin costo) · real = APIs reales
LLM_MODE=mock

# Necesarias con LLM_MODE=real
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Opcional: tercera evaluación independiente, transcripción y auditoría de cobertura
GEMINI_API_KEY=
USE_GEMINI=true

# Con USE_GEMINI=false (o sin clave), Anthropic transcribe, OpenAI revisa cobertura
# y el jurado queda con dos proveedores. Los empates requieren revisión
# editorial con origen y nota visibles (humana o de un asistente de IA).
# USE_ANTHROPIC=false permite reanudar con resultados de Anthropic ya guardados
# en caché; si falta una extracción o voto, esa etapa no podrá completarse.
USE_ANTHROPIC=true

# Modelos (configurables; verificar los IDs vigentes en la documentación oficial de cada proveedor)
MODELO_ANTHROPIC=claude-opus-5-5
MODELO_OPENAI=gpt-6.1-sol
MODELO_GEMINI=gemini-4-carbon

# Tope de gasto por corrida (USD): el pipeline se detiene al alcanzarlo
MAX_USD=15
